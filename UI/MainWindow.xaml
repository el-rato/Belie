<Window x:Class="WallpaperProfiles.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperProfiles.UI"
        x:ClassModifier="internal"
        Title="Belie" Width="1040" Height="790" MinWidth="880" MinHeight="650"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False">
                    <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Belie" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="WorkspaceTitle" Text="/  Profiles" Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinBtn_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <Path Data="M0,0 L10,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="M0,0 L10,0 10,10 0,10 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseBtn_Click" ToolTip="Close to tray" AutomationProperties.Name="Close to tray">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,24,18,18">
                    <Button x:Name="DashboardNavButton" Style="{StaticResource NavigationButton}" Click="ShowDashboard_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Activity"/></StackPanel>
                    </Button>
                    <Button x:Name="CanvasNavButton" Style="{StaticResource NavigationButton}" Click="ShowCanvas_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xECA5;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Widgets"/></StackPanel>
                    </Button>
                    <Button x:Name="ProfilesNavButton" Style="{StaticResource NavigationButton}" Click="ShowProfiles_Click" Background="{DynamicResource AccentSubtleBrush}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Profiles"/></StackPanel>
                    </Button>
                    <Button x:Name="LibraryNavButton" Style="{StaticResource NavigationButton}" Click="OpenLibrary_Click" ToolTip="Wallpaper library" Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Library"/></StackPanel>
                    </Button>
                    <Grid>
                        <TextBox x:Name="SearchBox" Height="36" Padding="10,7" TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Search profiles" ToolTip="Filter profiles by name"/>
                        <TextBlock Text="Search profiles" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,14,18,20">
                    <Button Content="+  New profile" Click="NewProfile_Click" Height="38" HorizontalContentAlignment="Center"/>
            <Grid Margin="0,10,0,0">
                <Button x:Name="SettingsButton" Style="{StaticResource NavigationButton}" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel>
                </Button>
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border CornerRadius="14" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <ListBox x:Name="ThemePicker" SelectionChanged="Theme_Changed" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,18" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="App theme">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Choice" CornerRadius="10" Padding="8" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Width="62">
                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Startup" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" Content="Start with Windows" x:Name="AutostartToggle"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" Margin="0,0,0,14"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" Content="Start in tray" x:Name="MinimizedToggle"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </StackPanel>
                </Border></Popup>
            </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,10,0">
                    <StackPanel>
                        <StackPanel x:Name="RailStack"/>
                        <TextBlock x:Name="SearchEmpty" Text="No matching profiles" Style="{StaticResource HintText}"
                                   Margin="8,12" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ProfilePane" Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" MaxWidth="860">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBox x:Name="NameBox" FontSize="27" FontWeight="SemiBold" Padding="0,4" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Profile name" ToolTip="Rename profile"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="EditProfileButton" Content="Edit profile" Tag="Wallpaper" Click="EditRules_Click" Height="36" Margin="0,0,8,0" Padding="12,7" ToolTip="Edit this profile"/>
                        <Button Content="Save" Click="Save_Click" Height="36" Margin="0,0,8,0" Padding="16,7" ToolTip="Save profile changes"/>
                        <Button Content="Apply" Style="{StaticResource PrimaryButton}" Click="ApplyNow_Click" Height="36" Padding="18,7"
                                ToolTip="Save and apply this wallpaper right now"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="DropZone" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" AllowDrop="True"
                        Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                    <Grid x:Name="PreviewFrame">
                        <local:MonitorThumbnail x:Name="PreviewMon" ShowName="False" BezelWidth="{Binding ActualWidth, ElementName=PreviewFrame}"
                                                BezelHeight="260" IsActive="False"/>
                        <Border x:Name="DropOverlay" CornerRadius="8" Background="{DynamicResource BgBrush}" Opacity="0.97" Visibility="Collapsed">
                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Margin="16" Background="{DynamicResource AccentSubtleBrush}">
                                <TextBlock Text="Drop an image, video, or folder" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
                <TabControl x:Name="ProfileTabs" Margin="0,18,0,0">
                <TabItem Header="Wallpaper"><StackPanel>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Source" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Folder" Style="{StaticResource QuietButton}" Click="Browse_Click" ToolTip="Choose a folder for a slideshow"/>
                        <Button Content="Image" Style="{StaticResource QuietButton}" Click="PickImage_Click" ToolTip="Choose a single image"/>
                        <Button Content="Video" Style="{StaticResource QuietButton}" Click="PickVideo_Click" ToolTip="Choose a live wallpaper video"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="FolderBox" Height="36" FontSize="12" AutomationProperties.Name="Wallpaper source path"/>
                <StackPanel Orientation="Horizontal" Margin="0,9,0,18">
                    <Ellipse x:Name="PathStatusDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0" Fill="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="PathStatusText" Style="{StaticResource HintText}" Text="No location set" TextWrapping="Wrap"/>
                </StackPanel>
                <DockPanel><TextBlock Text="Image fit" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox x:Name="FitCombo" Width="180" HorizontalAlignment="Left" ItemsSource="{x:Static local:EnumLists.FitModes}" AutomationProperties.Name="Image fit"/></DockPanel>
                </StackPanel></TabItem>
                <TabItem Header="Playback">
                        <StackPanel Margin="0,14,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Slideshow · minutes"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" x:Name="IntervalBox" Width="70" Height="36" ToolTip="0 turns slideshow off" AutomationProperties.Name="Slideshow interval in minutes"/>
                            </Grid>
                            <CheckBox x:Name="RandomBox" Style="{StaticResource SwitchStyle}" Content="Shuffle" Margin="0,16,0,0"/>
                            <CheckBox x:Name="VideoMuteBox" Style="{StaticResource SwitchStyle}" Content="Mute video" Margin="0,14,0,0"/>
                            <CheckBox x:Name="IconSafeBox" Style="{StaticResource SwitchStyle}" Content="Keep icons visible" Margin="0,14,0,0"
                                      ToolTip="Plays video as the desktop wallpaper at a reduced frame rate, keeping icons and taskbar visible."/>
                        </StackPanel>
                </TabItem>
                <TabItem Header="Automation"><StackPanel>
                            <TextBlock Text="Schedules" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ScheduleSummary" TextWrapping="Wrap"/>
                            <TextBlock Text="Triggers" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                            <TextBlock x:Name="TriggerSummary" TextWrapping="Wrap"/>
                            <Button x:Name="EditRulesButton" Content="+  Schedule or trigger" Tag="Rules" Click="EditRules_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel></TabItem>
                <TabItem Header="Mood"><StackPanel>
                    <Button Content="Customize mood" Tag="Mood" Click="EditRules_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="SceneSummary" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel></TabItem>
                </TabControl>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="⧉" Style="{StaticResource QuietButton}" Click="Duplicate_Click" ToolTip="Duplicate profile" AutomationProperties.Name="Duplicate profile"/>
                    <Button Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Style="{StaticResource DangerButton}" Click="Delete_Click" BorderThickness="0" ToolTip="Delete profile" AutomationProperties.Name="Delete profile"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="LibraryPane" Grid.Column="1" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <ScrollViewer x:Name="DashboardPane" Grid.Column="1" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24" MaxWidth="760">
                <TextBlock Text="Activity" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,22"/>
                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Now playing" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ActiveProfileText" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ActivationReasonText" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="AmbientMuteButton" DockPanel.Dock="Right" Content="Mute ambient" Click="AmbientMute_Click" Margin="12,0,0,0" Padding="10,5"/>
                            <TextBlock x:Name="AmbientStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="0,14,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Up next" Style="{StaticResource HintText}"/>
                            <TextBlock x:Name="NextScheduleText" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,7" TextWrapping="Wrap"/>
                            <TextBlock x:Name="NextScheduleHint" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Automation" Style="{StaticResource HintText}"/>
                            <TextBlock x:Name="AutomationModeText" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,7"/>
                            <TextBlock x:Name="AutomationHintText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button x:Name="PauseAutomationButton" Content="Pause automation" Click="PauseAutomation_Click" HorizontalAlignment="Left" Padding="10,5"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Play for a while" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Profile" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="OverrideProfileCombo" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OverrideProfile_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Duration" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="OverrideDurationCombo" DisplayMemberPath="Label"/>
                            </StackPanel>
                            <Button Grid.Column="4" x:Name="StartOverrideButton" Content="Play" Style="{StaticResource PrimaryButton}" Click="StartOverride_Click" VerticalAlignment="Bottom" Padding="12,7"/>
                        </Grid>
                        <TextBlock x:Name="OverrideStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <Button x:Name="ResumeAutomaticButton" Content="Resume automatic" Click="ResumeAutomatic_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,5"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Quick moods" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,12"/>
                <UniformGrid Columns="3">
                    <Button Content="◎  Focus" Tag="Focus" Click="CreateScene_Click" Margin="0,0,8,0" Padding="10,16" Background="{DynamicResource SurfaceRaisedBrush}"/>
                    <Button Content="◇  Gaming" Tag="Gaming" Click="CreateScene_Click" Margin="0,0,8,0" Padding="10,16" Background="{DynamicResource SurfaceRaisedBrush}"/>
                    <Button Content="☾  Evening" Tag="Evening" Click="CreateScene_Click" Padding="10,16" Background="{DynamicResource SurfaceRaisedBrush}"/>
                </UniformGrid>
                <TextBlock Text="Recent activity" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,12"/>
                <TextBlock x:Name="NoActivityText" Text="No activity yet"
                           Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                <ItemsControl x:Name="RecentActivityList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AtLocal, StringFormat={}{0:t}}" Style="{StaticResource HintText}" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="CanvasPane" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

    </Grid>
</Window>
