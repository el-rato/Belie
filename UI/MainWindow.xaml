<Window x:Class="WallpaperProfiles.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperProfiles.UI"
        x:ClassModifier="internal"
        Title="Belie" Width="1180" Height="820" MinWidth="640" MinHeight="650"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Background="{DynamicResource BackdropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- One bar, like a desktop status bar: where you are on the left, what is happening on the right. -->
        <Grid x:Name="TopBar" Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag" Margin="12,0,6,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,14,0" IsHitTestVisible="False">
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="BrandName" Text="belie" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="9,0,0,0"/>
                <TextBlock x:Name="WorkspaceTitle" Visibility="Collapsed"/>
                <Border x:Name="DevBuildBadge" Visibility="Collapsed" Margin="10,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource SignalBrush}" AutomationProperties.Name="Dev build">
                    <TextBlock Text="dev" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource SignalBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="19" Padding="4"
                    Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource PaneEdgeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                        <Button x:Name="DashboardNavButton" AutomationProperties.Name="Home" Style="{StaticResource NavPill}" Click="ShowDashboard_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Home" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="ProfilesNavButton" AutomationProperties.Name="Profiles" Style="{StaticResource NavPill}" Click="ShowProfiles_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Profiles" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="CanvasNavButton" AutomationProperties.Name="Widgets" Style="{StaticResource NavPill}" Click="ShowCanvas_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xECA5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Widgets" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="LibraryNavButton" AutomationProperties.Name="Library" Style="{StaticResource NavPill}" Click="OpenLibrary_Click" ToolTip="Wallpaper library">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Library" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    <Grid>
                        <Button x:Name="MoreNavButton" AutomationProperties.Name="More sections" Style="{StaticResource NavPill}" Click="MoreNav_Click" ToolTip="Top bar, workspaces, transitions, team and switcher">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="MoreNavLabel" Text="More" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Margin="8,1,0,0"/></StackPanel>
                        </Button>
                        <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreNavButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Margin="8" Padding="6" CornerRadius="12" MinWidth="210" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource FloatElevation}">
                                <StackPanel>
                                    <Button x:Name="TopBarNavButton" AutomationProperties.Name="Top bar" Style="{StaticResource NavigationButton}" Click="ShowTopBar_Click" Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90E;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Top bar"/></StackPanel>
                                    </Button>
                                    <Button x:Name="WorkspacesNavButton" AutomationProperties.Name="Workspaces" Style="{StaticResource NavigationButton}" Click="ShowWorkspaces_Click" Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C4;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Workspaces"/></StackPanel>
                                    </Button>
                                    <Button x:Name="TransitionsNavButton" AutomationProperties.Name="Transitions" Style="{StaticResource NavigationButton}" Click="ShowTransitions_Click" Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Transitions"/></StackPanel>
                                    </Button>
                                    <Button x:Name="TeamNavButton" AutomationProperties.Name="Team" Style="{StaticResource NavigationButton}" Click="ShowTeam_Click" Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Team"/></StackPanel>
                                    </Button>
                                    <Button x:Name="SwitcherNavButton" AutomationProperties.Name="Wallpaper switcher" Style="{StaticResource NavigationButton}" Click="ShowSwitcher_Click" Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Switcher"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateNotice" Style="{StaticResource StatusPill}" Click="Settings_Click" Visibility="Collapsed" AutomationProperties.Name="Update available">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Update" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="ActiveProfilePill" Style="{StaticResource StatusPill}" Click="EditActiveProfile_Click" ToolTip="The profile on your desktop. Click to edit it." AutomationProperties.Name="Edit applied desktop profile">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ActivePillDot" Width="7" Height="7" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActivePillName" Text="{Binding Text, ElementName=ActiveProfileText}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AutomationPill" Style="{StaticResource StatusPill}" Click="PauseAutomation_Click" AutomationProperties.Name="Pause or resume automation">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AutomationPillIcon" Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="AutomationPillText" Text="Auto" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Grid>
                    <Button x:Name="SettingsButton" AutomationProperties.Name="Settings" Style="{StaticResource StatusPill}" Click="Settings_Click" ToolTip="Settings" Padding="9,6">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                    </Button>
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                <Border Padding="24" Background="{DynamicResource PaneBaseBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="App updates" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InstalledVersionText" Style="{StaticResource HintText}" FontSize="12" Margin="0,5,12,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" Padding="12,8" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="Check for updates"/>
                    </Grid>
                    <TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="WhatsNewButton" Content="What's new" Click="ReleaseNotes_Click" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                        <Button x:Name="AvailableReleaseNotesButton" Content="Release notes" Tag="Update" Click="ReleaseNotes_Click" Padding="12,8" FontSize="12" Visibility="Collapsed"/>
                    </WrapPanel>
                    <Button x:Name="SettingsUpdateButton" Content="Update and restart" Click="UpdateNow_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,22,0,22"/>
                    <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <ListBox x:Name="ThemePicker" SelectionChanged="Theme_Changed" Background="Transparent" BorderThickness="0" Padding="0" Margin="-3,0,-3,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="App theme">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property=" AutomationProperties.Name" Value="{Binding Name}"/>
                                  <Setter Property="Margin" Value="3,0,3,12"/><Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Choice" CornerRadius="8" Padding="5,6" BorderThickness="1" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <Border Height="38" CornerRadius="4" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{Binding Surface}" CornerRadius="2" Margin="0,0,4,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Height="4" Background="{Binding Accent}" CornerRadius="2" Margin="0,0,0,4"/>
                                        <Border Height="3" Background="{Binding Muted}" CornerRadius="1" Margin="0,0,5,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{StaticResource TypeCaption}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid MinHeight="34" Margin="0,4,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,132,0">
                            <TextBlock Text="Glass" FontSize="{StaticResource TypeBody}"/>
                            <TextBlock x:Name="GlassHint" Style="{StaticResource HintText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="GlassPicker" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Glass_Changed"
                                  AutomationProperties.Name="Glass" ToolTip="How much of your desktop shows through the window"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,22,0,22"/>
                    <TextBlock Text="Startup" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid MinHeight="34" Margin="0,0,0,8">
                        <TextBlock Text="Start with Windows" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="0,0,62,0"/>
                        <CheckBox Style="{StaticResource SwitchStyle}" x:Name="AutostartToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="Start with Windows" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </Grid>
                    <Grid MinHeight="34">
                        <TextBlock Text="Start in tray" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="0,0,62,0"/>
                        <CheckBox Style="{StaticResource SwitchStyle}" x:Name="MinimizedToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="Start in tray" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </Grid>
                </StackPanel>
                </Border></Popup>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Style="{StaticResource TitleBarButton}" Click="MinBtn_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Path Data="M0,0 L10,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <Path x:Name="MaximizeGlyph" Data="M0,0 L10,0 10,10 0,10 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseBtn_Click" ToolTip="Close to tray" AutomationProperties.Name="Close to tray">
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The profile list: its own pane, shown next to the profile editor. -->
        <ContentControl x:Name="SidebarFrame" Grid.Row="1" Style="{StaticResource GlassPane}" Margin="12,0,3,12" Visibility="Collapsed">
            <DockPanel Margin="10,14,10,12">
                <Button x:Name="NewProfileButton" DockPanel.Dock="Bottom" Content="+  New profile" ToolTip="New profile" Click="NewProfile_Click" Style="{StaticResource PillButton}" Padding="12,8" Margin="0,10,0,0" AutomationProperties.Name="New profile"/>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid x:Name="ProfileSearchArea">
                        <TextBox x:Name="SearchBox" Height="36" Padding="10,7" TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Search profiles" ToolTip="Filter profiles by name"/>
                        <TextBlock x:Name="ProfileSearchHint" Text="Search profiles" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
                <ScrollViewer x:Name="ProfileRailArea" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="ProfileRailHeading" Text="Profiles" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="18,0,0,10"/>
                        <StackPanel x:Name="RailStack"/>
                        <TextBlock x:Name="SearchEmpty" Text="No matching profiles" Style="{StaticResource HintText}"
                                   Margin="8,12" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </ContentControl>

        <ContentControl x:Name="ContentFrame" Grid.Column="1" Grid.Row="1" Style="{StaticResource GlassPane}" Margin="12,0,12,12">
        <Grid x:Name="PaneHost">
        <Grid x:Name="ProfilePane">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="ProfileHeader" Margin="24,20,24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBox x:Name="NameBox" FontSize="{StaticResource TypeTitle}" FontWeight="SemiBold" Padding="0,4" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Profile name" ToolTip="Rename profile"/>
                        <Button x:Name="ShortcutButton" Content="Assign shortcut" Click="Shortcut_Click" HorizontalAlignment="Left" Padding="8,4" FontSize="12" Margin="0,5,0,0" ToolTip="Switch to this profile from anywhere, including the tray"/>
                        <Popup x:Name="ShortcutPopup" PlacementTarget="{Binding ElementName=ShortcutButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="ShortcutPopup_Closed">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Width="320">
                                <StackPanel>
                                    <TextBlock Text="Profile shortcut" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Click below and press a key combination, such as Ctrl + Alt + 1." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                    <TextBox x:Name="ShortcutCapture" IsReadOnly="True" PreviewKeyDown="ShortcutCapture_KeyDown" AutomationProperties.Name="Record profile shortcut" Height="40"/>
                                    <TextBlock x:Name="ShortcutMessage" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                    <DockPanel>
                                        <Button Content="Remove" Click="RemoveShortcut_Click" DockPanel.Dock="Left" Padding="10,7"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Click="CancelShortcut_Click" Padding="10,7" Margin="0,0,6,0"/>
                                            <Button Content="Assign" Click="AssignShortcut_Click" Style="{StaticResource PrimaryButton}" Padding="12,7"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MoreProfileButton" Content="&#xE712;" FontFamily="{StaticResource IconFont}" Width="36" ToolTip="More profile actions" Click="MoreProfile_Click" Height="36" Padding="12,7" Margin="0,0,8,0" AutomationProperties.Name="More profile actions">
                            <Button.ContextMenu><ContextMenu><MenuItem Header="Duplicate profile" Click="Duplicate_Click"/><MenuItem Header="Delete profile" Click="Delete_Click"/></ContextMenu></Button.ContextMenu>
                        </Button>
                        <Button x:Name="SaveProfileButton" Content="Save" Click="Save_Click" Height="36" Margin="0,0,8,0" Padding="16,7" ToolTip="Save profile changes"/>
                        <Button x:Name="ApplyProfileButton" Content="Apply to desktop" Style="{StaticResource PrimaryButton}" Click="ApplyNow_Click" Height="36" Padding="18,7"
                                ToolTip="Save and apply this wallpaper right now"/>
                    </StackPanel>
                </Grid>
                </Border>

            <TextBlock x:Name="ProfileMessage" Grid.Row="1" Margin="24,0,24,12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            <ScrollViewer x:Name="ProfileDetailsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24" MaxWidth="980">
                <Border x:Name="DropZone" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0" CornerRadius="8" AllowDrop="True"
                        Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                    <Grid x:Name="PreviewFrame" Height="210">
                        <Border CornerRadius="8" Background="{DynamicResource BgBrush}"/>
                        <Border CornerRadius="15" Opacity="0.18" IsHitTestVisible="False">
                            <Border.Background><ImageBrush ImageSource="{Binding ScreenSource, ElementName=PreviewMon}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <local:MonitorThumbnail x:Name="PreviewMon" ShowName="False" BezelWidth="373" HorizontalAlignment="Center"
                                                BezelHeight="210" IsActive="False">
                            <local:MonitorThumbnail.Style><Style TargetType="local:MonitorThumbnail">
                                <Style.Triggers><Trigger Property="ScreenSource" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                            </Style></local:MonitorThumbnail.Style>
                        </local:MonitorThumbnail>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,35">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ScreenSource, ElementName=PreviewMon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <TextBlock x:Name="PreviewEmptyTitle" Text="Choose a wallpaper" FontSize="{StaticResource TypeTitle}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewEmptyHint" Text="Drop an image or video" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,10,0,20" TextWrapping="Wrap"/>
                            <Button Content="Choose a wallpaper  →" Click="PickImage_Click" HorizontalAlignment="Center" Padding="16,8"/>
                        </StackPanel>
                        <Border Style="{StaticResource PreviewOverlay}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PreviousPreviewButton" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Click="BrowsePreview_Click" Tag="-1" Width="36" Height="36" Padding="0" Foreground="White" BorderThickness="0" ToolTip="Previous wallpaper" AutomationProperties.Name="Previous wallpaper" IsEnabled="False"/>
                                <TextBlock x:Name="PreviewPositionText" Text="Desktop preview" Foreground="White" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="10,0"/>
                                <Button x:Name="NextPreviewButton" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Click="BrowsePreview_Click" Tag="1" Width="36" Height="36" Padding="0" Foreground="White" BorderThickness="0" ToolTip="Next wallpaper" AutomationProperties.Name="Next wallpaper" IsEnabled="False"/>
                                <Border Width="1" Background="#506C8076" Margin="8,4"/>
                                <Button x:Name="ExpandPreviewButton" Content="&#xE740;" FontFamily="{StaticResource IconFont}" Click="ExpandPreview_Click" Width="36" Height="36" Padding="0" Foreground="White" BorderThickness="0" ToolTip="Expand preview" AutomationProperties.Name="Expand wallpaper preview">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ScreenSource, ElementName=PreviewMon}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DropOverlay" CornerRadius="8" Background="{DynamicResource BgBrush}" Opacity="0.97" Visibility="Collapsed">
                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Margin="16" Background="{DynamicResource AccentSubtleBrush}">
                                <TextBlock Text="Drop an image, video, or folder" FontWeight="SemiBold" FontSize="{StaticResource TypeBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
                <TabControl x:Name="ProfileTabs" Style="{StaticResource StudioTabs}" Margin="0,16,0,0">
                <TabItem Header="Wallpaper"><StackPanel>
                <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
                <WrapPanel Margin="0,4,0,12">
                    <Button x:Name="AddFromLibraryButton" Content="Library" Click="OpenLibrary_Click" Margin="0,0,8,8" ToolTip="Add from library" AutomationProperties.Name="Add from library"/>
                    <Button Content="Widgets" Click="ComposeWallpaper_Click" Margin="0,0,8,8" ToolTip="Arrange widgets for the wallpaper in this preview" AutomationProperties.Name="Compose widgets"/>
                    <Button Content="Folder" Click="Browse_Click" Margin="0,0,8,8" ToolTip="Choose folder" AutomationProperties.Name="Choose folder"/>
                    <Button Content="Image" Click="PickImage_Click" Margin="0,0,8,8" ToolTip="Choose image" AutomationProperties.Name="Choose image"/>
                    <Button Content="Video" Click="PickVideo_Click" Margin="0,0,0,8" ToolTip="Choose video" AutomationProperties.Name="Choose video"/>
                </WrapPanel>
                <DockPanel Visibility="Collapsed">
                    <local:SourceThumbnail FilePath="{Binding Text, ElementName=FolderBox}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SourceNameText" Text="No source selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="FolderBox" Visibility="Collapsed"/>
                <StackPanel x:Name="PathStatusPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,9,0,18">
                    <Ellipse x:Name="PathStatusDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0" Fill="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="PathStatusText" Style="{StaticResource HintText}" Text="No location set" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                    <ScrollViewer.Style><Style TargetType="ScrollViewer">
                        <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ProfileWallpaperList}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style></ScrollViewer.Style>
                    <local:WallpaperThumbnailList x:Name="ProfileWallpaperList" OrderChanged="WallpaperOrder_Changed" Cursor="Hand" ToolTip="Drag wallpapers to change their order" AutomationProperties.Name="Wallpapers in this profile">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Padding="3" Margin="0,0,8,8" CornerRadius="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <local:SourceThumbnail FilePath="{Binding}" Width="80" Height="50" AutomationProperties.Name="{Binding}"/>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </local:WallpaperThumbnailList>
                </ScrollViewer>
                <DockPanel><TextBlock Text="Fit" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox x:Name="FitCombo" Width="180" HorizontalAlignment="Left" ItemsSource="{x:Static local:EnumLists.FitModes}" AutomationProperties.Name="Image fit"/></DockPanel>
                </StackPanel></TabItem>
                <TabItem Header="Playback">
                        <StackPanel Margin="0,14,0,8">
                            <TextBlock Text="Playback" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource SettingsCard}"><Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Slideshow · minutes"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" x:Name="IntervalBox" Width="70" Height="36" ToolTip="0 turns slideshow off" AutomationProperties.Name="Slideshow interval in minutes"/>
                            </Grid></Border>
                            <Border Style="{StaticResource SettingsCard}"><DockPanel><CheckBox DockPanel.Dock="Right" x:Name="RandomBox" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" AutomationProperties.Name="Shuffle wallpapers" ToolTip="Randomize wallpaper order"/><StackPanel Margin="0,0,14,0"><TextBlock Text="Shuffle" FontWeight="SemiBold"/></StackPanel></DockPanel></Border>
                            <Border Style="{StaticResource SettingsCard}"><DockPanel><CheckBox DockPanel.Dock="Right" x:Name="VideoMuteBox" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" AutomationProperties.Name="Mute video" ToolTip="Play video wallpapers without audio"/><StackPanel Margin="0,0,14,0"><TextBlock Text="Mute video" FontWeight="SemiBold"/></StackPanel></DockPanel></Border>
                            <Border Style="{StaticResource SettingsCard}"><DockPanel><CheckBox DockPanel.Dock="Right" x:Name="IconSafeBox" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" AutomationProperties.Name="Keep icons visible" ToolTip="Plays video at a reduced frame rate, keeping icons and taskbar visible."/><StackPanel Margin="0,0,14,0"><TextBlock Text="Keep icons visible" FontWeight="SemiBold"/></StackPanel></DockPanel></Border>
                        </StackPanel>
                </TabItem>
                <TabItem Header="Automation"><StackPanel>
                            <TextBlock Text="Automation" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="Schedules" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ScheduleSummary" TextWrapping="Wrap"/>
                            </StackPanel></Border><Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="Triggers" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                            <TextBlock x:Name="TriggerSummary" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                            <Button x:Name="EditRulesButton" Content="Edit schedules &amp; triggers" Tag="Rules" Click="EditRules_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel></TabItem>
                <TabItem Header="Mood"><StackPanel>
                    <TextBlock Text="Appearance &amp; audio" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"/>
                    <Button Content="Edit mood" Tag="Mood" Click="EditRules_Click" HorizontalAlignment="Left" Padding="16,10"/>
                <TextBlock x:Name="SceneSummary" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel></TabItem>
                </TabControl>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <ContentControl x:Name="LibraryPane" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <ScrollViewer x:Name="DashboardPane" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,26" MaxWidth="760">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Overview" FontSize="{StaticResource TypeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="OpenLibrary_Click" VerticalAlignment="Center" Padding="14,10" ToolTip="Explore your wallpaper library">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Explore library"/></StackPanel>
                    </Button>
                </Grid>
                <Border CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource SceneAccentSubtleColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid MinHeight="270">
                        <Border CornerRadius="19">
                            <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#123D40" Offset="0"/><GradientStop Color="#658F78" Offset="0.55"/><GradientStop Color="#D7BD91" Offset="1"/>
                            </LinearGradientBrush></Border.Background>
                        </Border>
                        <Border CornerRadius="19" Opacity="1">
                            <Border.Background><ImageBrush x:Name="ActivityWallpaperBrush" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <Border CornerRadius="19" IsHitTestVisible="False">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#05090F0B" Offset="0"/>
                                <GradientStop Color="#D9090F0B" Offset="1"/>
                            </LinearGradientBrush></Border.Background>
                        </Border>
                        <Grid Margin="24">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="YOUR DESKTOP" Foreground="#F3F8F1" FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ActiveStateDot" Width="6" Height="6" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ActiveStateText" Text="NO PROFILE APPLIED" Foreground="#E1EBE4" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Grid.Row="2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock x:Name="ActiveProfileText" Foreground="White" FontSize="{StaticResource TypeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ActivationReasonText" Foreground="#C9D5CD" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="EditActiveProfileButton" Grid.Column="1" Content="Edit profile  →" Click="EditActiveProfile_Click"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Padding="14,9"/>
                                </Grid>
                                <DockPanel Margin="0,14,0,0">
                                    <Button x:Name="AmbientMuteButton" DockPanel.Dock="Right" Content="Mute ambient" Click="AmbientMute_Click"
                                            Foreground="White" Background="#402C3930" BorderBrush="#607D9384" Margin="12,0,0,0" Padding="10,5"/>
                                    <TextBlock x:Name="AmbientStatusText" Foreground="#C9D5CD" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <!-- What happens next and whether automation is running, side by side in one slim strip. -->
                <Border Style="{StaticResource GlassCard}" Padding="18,13" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Up next" Style="{StaticResource HintText}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock x:Name="NextScheduleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NextScheduleHint" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource CardEdgeBrush}" Margin="20,2"/>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Automation" Style="{StaticResource HintText}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock x:Name="AutomationModeText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AutomationHintText" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="PauseAutomationButton" Content="Pause automation" Click="PauseAutomation_Click" Style="{StaticResource PillButton}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Margin="0,28,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Profiles" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SceneGalleryCount" FontFamily="{StaticResource MonoFont}" Style="{StaticResource HintText}" Margin="10,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+  New profile" Click="NewProfile_Click" Style="{StaticResource PillButton}" VerticalAlignment="Center" AutomationProperties.Name="New profile"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,10"
                              PreviewMouseWheel="SceneGallery_PreviewMouseWheel">
                    <StackPanel x:Name="SceneGallery" Orientation="Horizontal"/>
                </ScrollViewer>
                <Border x:Name="SceneGalleryEmpty" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <StackPanel><TextBlock Text="Create your first profile" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"/><TextBlock Text="Create a profile with a wallpaper, then switch to it in one click." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,16"/><Button Content="Create a profile  →" Click="NewProfile_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,30,0,12">
                    <TextBlock Text="Take over for a while" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="show one profile, then go back to your rules" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,3,0,0"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="OverrideProfileCombo" Width="220" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OverrideProfile_Changed" AutomationProperties.Name="Profile" Margin="0,0,0,6"/>
                    <TextBlock Text="for" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,12,6"/>
                    <ComboBox x:Name="OverrideDurationCombo" Width="130" DisplayMemberPath="Label" AutomationProperties.Name="Duration" Margin="0,0,0,6"/>
                    <Button x:Name="StartOverrideButton" Content="Apply" Style="{StaticResource AccentPillButton}" Click="StartOverride_Click" VerticalAlignment="Center" Margin="12,0,0,6" Padding="16,7"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="OverrideStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="ResumeAutomaticButton" Content="Resume automation" Click="ResumeAutomatic_Click" Style="{StaticResource PillButton}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Recent" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold" Margin="0,30,0,10"/>
                <TextBlock x:Name="NoActivityText" Text="Nothing has happened yet" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                <ItemsControl x:Name="RecentActivityList" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AtLocal, StringFormat={}{0:t}}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Reason}">
                                    <Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Reason, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="CanvasPane" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ContentControl x:Name="TopBarPane" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ContentControl x:Name="WorkspacesPane" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ContentControl x:Name="TeamPane" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ContentControl x:Name="TransitionsPane" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ContentControl x:Name="SwitcherPane" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
        </ContentControl>

        <StackPanel x:Name="ToastHost" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" IsHitTestVisible="False" Panel.ZIndex="10"/>

    </Grid>
</Window>
