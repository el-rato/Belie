<Window x:Class="WallpaperProfiles.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperProfiles.UI"
        x:ClassModifier="internal"
        Title="Belie" Width="920" Height="660" MinWidth="800" MinHeight="560"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                    <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Belie" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="MinBtn_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="CloseBtn_Click" ToolTip="Close to tray"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left rail -->
        <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Profiles" Style="{StaticResource SectionTitle}"
                           Margin="16,16,0,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,10,10">
                    <StackPanel x:Name="RailStack"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right pane -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,18">
                <Grid MaxWidth="560" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Profile name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" Height="38" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,8" Click="ApplyNow_Click"
                                ToolTip="Save and apply this wallpaper right now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Apply" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,8" Margin="6,0,0,0" Click="Save_Click" ToolTip="Save changes to this profile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Padding="12,8" Margin="6,0,0,0" Click="Delete_Click" ToolTip="Delete this profile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Delete" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="DropZone" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                        HorizontalAlignment="Center" AllowDrop="True"
                        Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                    <Grid>
                        <local:MonitorThumbnail x:Name="PreviewMon" ShowName="False" Margin="10"
                                                BezelWidth="330" BezelHeight="206" IsActive="True"/>
                        <Border x:Name="DropOverlay" CornerRadius="8" Background="{StaticResource BgBrush}" Opacity="0.97" Visibility="Collapsed">
                            <Grid>
                                <Rectangle Width="294" Height="180" RadiusX="8" RadiusY="8" Stroke="{StaticResource AccentBrush}"
                                           StrokeThickness="1.5" StrokeDashArray="4 3" Fill="{StaticResource AccentSubtleBrush}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Drop an image, video, or folder" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0"
                        MaxWidth="560" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Wallpaper" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Padding="10,6" Margin="0,0,6,0" Click="Browse_Click" ToolTip="Pick a folder of images">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Folder" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Padding="10,6" Margin="0,0,6,0" Click="PickImage_Click" ToolTip="Pick a single image">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Image" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Padding="10,6" Click="PickVideo_Click" ToolTip="Pick a live wallpaper video (plays behind your desktop icons)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Video" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="2,7,0,0">
                            <Ellipse x:Name="PathStatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Margin="0,0,6,0" Fill="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="PathStatusText" Style="{StaticResource HintText}" Text="No location set"/>
                            <TextBlock Style="{StaticResource HintText}" Text="· you can drag &amp; drop onto the preview"
                                       Margin="8,0,0,0" Opacity="0.8"/>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fit mode" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox Grid.Column="1" x:Name="FitCombo" ItemsSource="{x:Static local:EnumLists.FitModes}"/>
                        </Grid>

                        <Expander Margin="0,12,0,0">
                            <Expander.Header>
                                <TextBlock Text="Playback &amp; automation" Style="{StaticResource SectionTitle}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slideshow interval (minutes, 0 = off)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="IntervalBox" FontFamily="{StaticResource MonoFont}"
                                             Width="70" HorizontalAlignment="Right"/>
                                </Grid>
                                <CheckBox x:Name="RandomBox" Content="Random slideshow order" Margin="0,12,0,0"/>
                                <CheckBox x:Name="VideoMuteBox" Content="Mute live video audio" Margin="0,12,0,0"
                                          ToolTip="Applies to video wallpapers; animated GIFs have no sound"/>
                                <CheckBox x:Name="IconSafeBox" Content="Keep desktop icons visible" Margin="0,12,0,0"
                                          ToolTip="Plays the video as the real desktop wallpaper at ~4 fps instead of a smooth overlay. Icons and taskbar stay fully visible."/>
                                <Button Padding="10,6" HorizontalAlignment="Left" Margin="0,14,0,0" Click="EditRules_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Edit schedule &amp; triggers…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="ScheduleSummary" Style="{StaticResource HintText}"
                                           Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TriggerSummary" Style="{StaticResource HintText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom strip -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="18,10,18,10">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Text="Changes apply instantly" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource SwitchStyle}" Content="Start with Windows"
                              x:Name="AutostartToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed" Margin="0,0,22,0"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" Content="Minimized to tray"
                              x:Name="MinimizedToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
