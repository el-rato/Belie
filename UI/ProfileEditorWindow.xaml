<Window x:Class="WallpaperProfiles.UI.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperProfiles.UI"
        x:ClassModifier="internal"
        Title="Belie — Edit Profile" Width="680" Height="720" MinWidth="620" MinHeight="600"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                    <TextBlock x:Name="TitleText" Text="Edit Profile" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
                <Button x:Name="CloseBtn" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Margin="0,0,6,0" Click="CloseBtn_Click" ToolTip="Close editor" AutomationProperties.Name="Close editor"/>
            </Grid>
        </Border>


        <TextBlock x:Name="EditorMessage" Grid.Row="1" Margin="22,12,22,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Polite"/>
        <TabControl x:Name="EditorTabs" Grid.Row="2" Style="{StaticResource StudioTabs}" Margin="22,18,22,8">
        <TabItem Header="Wallpaper"><ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="WallpaperEditorFields" Margin="0,0,8,8">
                <StackPanel x:Name="PresetPanel" Margin="0,0,0,16">
                    <TextBlock Text="Profile preset" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="PresetCombo" SelectionChanged="Preset_Changed"/>
                </StackPanel>
                <TextBlock Text="Profile name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" AutomationProperties.Name="Profile name"/>

                <local:MonitorThumbnail x:Name="EditorPreview" ShowName="False" IsActive="False"
                                        BezelWidth="338" BezelHeight="190" HorizontalAlignment="Center" Margin="0,16,0,0"/>

                <DockPanel Margin="0,16,0,6">
                    <Button x:Name="AddFromLibraryButton" DockPanel.Dock="Right" Content="+ Library" Padding="10,6"
                            Click="AddFromLibrary_Click" ToolTip="Add wallpapers from your library to this profile"/>
                    <TextBlock Text="Wallpaper source" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Remove source" Click="RemoveSource_Click" ToolTip="Original files are kept."/><local:SourceThumbnail FilePath="{Binding Text, ElementName=FolderBox}" Margin="0,0,12,0"/><TextBlock x:Name="SourceNameText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
                <Expander Header="Source path"><TextBox x:Name="FolderBox" FontSize="12" AutomationProperties.Name="Wallpaper source path" AllowDrop="True" Drop="FolderBox_Drop" DragOver="FolderBox_DragOver" DragLeave="FolderBox_DragLeave"/></Expander>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Choose folder" Click="Browse_Click" Margin="0,0,8,8"/>
                    <Button Content="Choose image" Click="PickImage_Click" Margin="0,0,8,8"/>
                    <Button Content="Choose video" Click="PickVideo_Click" Margin="0,0,0,8"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="2,7,0,0">
                    <Ellipse x:Name="PathStatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Margin="0,0,6,0" Fill="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="PathStatusText" Style="{StaticResource HintText}" Text="No location set"/>
                </StackPanel>

                <StackPanel x:Name="AdditionalWallpaperPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="AdditionalWallpaperCount" Style="{StaticResource FieldLabel}"/>
                    <ScrollViewer MaxHeight="115" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AdditionalWallpaperList">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <DockPanel Margin="0,0,0,5">
                                    <Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemoveProfileWallpaper_Click" Padding="8,3" FontSize="12" Margin="8,0,0,0"/>
                                    <local:SourceThumbnail FilePath="{Binding FilePath}" Margin="0,0,12,0"/><TextBlock Text="{Binding Name}" ToolTip="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <DockPanel Margin="0,16,0,0">
                    <TextBlock Text="Image fit" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ComboBox x:Name="FitCombo" Width="180" HorizontalAlignment="Left" ItemsSource="{x:Static local:EnumLists.FitModes}" AutomationProperties.Name="Image fit"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer></TabItem>
        <TabItem Header="Playback"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
            <DockPanel><TextBox x:Name="IntervalBox" Width="80" DockPanel.Dock="Right" AutomationProperties.Name="Slideshow interval in minutes" ToolTip="0 turns slideshow off"/><TextBlock Text="Slideshow interval · minutes" VerticalAlignment="Center"/></DockPanel>
                <StackPanel Margin="0,12,0,4">
                    <CheckBox x:Name="RandomOrderCheck" Style="{StaticResource SwitchStyle}" Content="Shuffle"/>
                    <CheckBox x:Name="VideoMuteCheck" Style="{StaticResource SwitchStyle}" Content="Mute video" Margin="0,12,0,0"
                              ToolTip="Applies to video wallpapers; animated GIFs have no sound"/>
                    <CheckBox x:Name="IconSafeCheck" Style="{StaticResource SwitchStyle}" Content="Keep icons visible" Margin="0,12,0,0"
                              ToolTip="Plays the video as the real desktop wallpaper at ~4 fps instead of a smooth overlay. Icons and taskbar stay fully visible."/>
                </StackPanel>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Automation"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <TextBlock Text="Automation" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Apply this profile on a schedule or when an event occurs." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Padding="10,4" Click="AddRule_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Add rule" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Schedule rules" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="RulesList" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <UniformGrid Columns="8">
                                        <TextBlock Text="Days:" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <CheckBox Content="Mo" Margin="0,0,6,0" IsChecked="{Binding Days[1]}"/>
                                        <CheckBox Content="Tu" Margin="0,0,6,0" IsChecked="{Binding Days[2]}"/>
                                        <CheckBox Content="We" Margin="0,0,6,0" IsChecked="{Binding Days[3]}"/>
                                        <CheckBox Content="Th" Margin="0,0,6,0" IsChecked="{Binding Days[4]}"/>
                                        <CheckBox Content="Fr" Margin="0,0,6,0" IsChecked="{Binding Days[5]}"/>
                                        <CheckBox Content="Sa" Margin="0,0,6,0" IsChecked="{Binding Days[6]}"/>
                                        <CheckBox Content="Su" IsChecked="{Binding Days[0]}"/>
                                    </UniformGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="From" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Width="84" ItemsSource="{x:Static local:EnumLists.Times}"
                                                  SelectedItem="{Binding StartTimeText}" Margin="0,0,10,0"/>
                                        <TextBlock Text="to" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Width="84" ItemsSource="{x:Static local:EnumLists.Times}"
                                                  SelectedItem="{Binding EndTimeText}"/>
                                        <Button Content="Remove" Margin="14,0,0,0" Padding="9,3" Click="RemoveRule_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoRulesHint" Style="{StaticResource HintText}" Margin="0,0,0,10"/>

                <Separator Margin="0,4,0,12"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Padding="10,4" Click="AddTrigger_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Add trigger" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Event triggers" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="TriggersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <WrapPanel>
                                        <ComboBox Width="230"
                                                  ItemsSource="{x:Static local:EnumLists.TriggerTypes}"
                                                  SelectedValue="{Binding Type}" SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"/>
                                        <TextBlock Text="when" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox Width="120" Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Priority" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox Width="44" Text="{Binding PriorityText}"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <TextBlock Text="Input:" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" FontStyle="Italic"/>
                                        <Button Content="Remove" Margin="14,0,0,0" Padding="9,3" Click="RemoveTrigger_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoTriggersHint" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Mood"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <TextBlock Text="Appearance &amp; audio" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Choose an accent color and optional ambient audio." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,4">
                    <StackPanel>
                        <TextBlock Text="Accent color" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Choose color" Click="ChooseAccent_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="SceneAccentBox" AutomationProperties.Name="Accent color" MaxLength="7" ToolTip="#RRGGBB · clear to use the default"/>
                        </DockPanel>
                        <TextBlock Text="Ambient audio (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse" Click="PickAudio_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="AudioPathBox" AutomationProperties.Name="Ambient audio file"/>
                        </DockPanel>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Slider Grid.Column="1" x:Name="AmbientVolumeSlider" AutomationProperties.Name="Ambient audio volume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=AmbientVolumeSlider, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <CheckBox x:Name="AmbientMuteBox" Style="{StaticResource SwitchStyle}" Content="Start muted" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
        </StackPanel></ScrollViewer></TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="96" Height="32" IsCancel="True" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="96" Height="32"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
