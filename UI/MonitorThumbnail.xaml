<UserControl x:Class="WallpaperProfiles.UI.MonitorThumbnail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperProfiles.UI"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Border x:Name="Bezel" BorderThickness="1" CornerRadius="6" Background="#0C0F13">
                <Border Margin="2" CornerRadius="4" ClipToBounds="True" Background="#0C0F13">
                    <Grid>
                        <Image x:Name="ScreenImage" Stretch="UniformToFill" Opacity="0.85"/>
                        <Border x:Name="VideoBadge" Background="#B3000000" CornerRadius="4" Padding="5,3"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
                                IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="White"/>
                        </Border>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Orientation="Vertical" IsHitTestVisible="False">
                            <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="No image" FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <Ellipse x:Name="SignalDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,10,10,0" Fill="{StaticResource SignalBrush}" Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="NameText" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="12,0,4,0" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="100"
                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
    </Grid>
</UserControl>
