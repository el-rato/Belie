<Window x:Class="WallpaperProfiles.UI.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperProfiles.UI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:ClassModifier="internal" Title="Wallpaper library" Width="1000" Height="720"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="{DynamicResource BgBrush}"
        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Window.Resources><local:GalleryCardWidthConverter x:Key="GalleryCardWidth"/></Window.Resources>
    <Grid x:Name="LibraryRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="LibraryChrome" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <Button x:Name="BackButton" Content="←  Profiles" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="18,0" Padding="10,5" BorderThickness="0" Click="Close_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="LibraryTitle" Text="Wallpaper library" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="18,0"/>
                <Button x:Name="LibraryCloseButton" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Margin="0,0,6,0" Click="Close_Click" ToolTip="Close library"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="20,18,20,14">
            <Border Margin="0,0,0,18">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkspaceBanner}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=MarketDetails}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Library" Style="{StaticResource WorkspaceHeading}"/></StackPanel>

                </Grid>
            </Border>
            <DockPanel>
                <StackPanel x:Name="ImportActions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ImportFilesButton" Content="+  Import" Style="{StaticResource PrimaryButton}" ToolTip="Import images or videos" Click="ImportFiles_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ImportFolderButton" Content="&#xE8B7;" FontFamily="{StaticResource IconFont}" ToolTip="Import folder" AutomationProperties.Name="Import folder" Click="ImportFolder_Click"/>
                </StackPanel>
                <StackPanel x:Name="LibraryTabs" Orientation="Horizontal">
                    <Button x:Name="LocalLibraryTab" Content="My collection" Background="{DynamicResource AccentSubtleBrush}" Click="LocalLibrary_Click" Margin="0,0,8,0" Padding="16,10"/>
                    <Button x:Name="MarketplaceTab" Content="Discover wallpapers" Click="Marketplace_Click" Padding="16,10"/>
                </StackPanel>
            </DockPanel>
            <Grid x:Name="LocalFilters" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0">
                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="Search library" ToolTip="Search names, tags, or collections"/>
                    <TextBlock Text="Search library" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Grid.Column="1" x:Name="CollectionFilter" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" ToolTip="Collection"/>
                <CheckBox Grid.Column="2" x:Name="FavoritesFilter" Content="★" ToolTip="Favorites only" AutomationProperties.Name="Favorites only" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            </Grid>
            <StackPanel x:Name="MarketFilters" Visibility="Collapsed" Margin="0,16,0,0">
                <DockPanel>
                    <Button x:Name="MarketSearchButton" DockPanel.Dock="Right" Content="Search" Style="{StaticResource AccentPillButton}" Click="MarketSearch_Click" Margin="10,0,0,0" Padding="18,8"/>
                    <Grid>
                        <TextBox x:Name="MarketSearchBox" KeyDown="MarketSearch_KeyDown" AutomationProperties.Name="Search Wallhaven tags" Padding="34,0,10,0" Height="40" VerticalContentAlignment="Center"
                                 ToolTip="Search by tag or keyword. +nature +mountains combines tags, -anime leaves one out."/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search wallpapers · +nature +mountains · -anime" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=MarketSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="MarketLandscapeOnly" Content="Landscape" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="MarketOrientation_Changed" Unchecked="MarketOrientation_Changed"
                                  ToolTip="Hide portrait wallpapers made for phones; include wide and ultrawide wallpapers."
                                  AutomationProperties.Name="Landscape wallpapers only, hide phone wallpapers"/>
                        <ComboBox x:Name="MarketResolution" SelectedIndex="0" Width="150" Margin="0,0,8,0" SelectionChanged="MarketFilter_Changed" ToolTip="Minimum resolution" AutomationProperties.Name="Minimum resolution">
                            <ComboBoxItem Content="Any size" Tag=""/>
                            <ComboBoxItem Content="Full HD+" Tag="1920x1080"/>
                            <ComboBoxItem Content="1440p+" Tag="2560x1440"/>
                            <ComboBoxItem Content="4K+" Tag="3840x2160"/>
                        </ComboBox>
                        <ComboBox x:Name="MarketPurity" SelectedIndex="0" Width="150" Margin="0,0,8,0" SelectionChanged="MarketPurity_Changed"
                                  ToolTip="Content rating. NSFW results need your Wallhaven API key." AutomationProperties.Name="Content rating">
                            <ComboBoxItem Content="Safe only" Tag="100"/>
                            <ComboBoxItem Content="Safe + sketchy" Tag="110"/>
                            <ComboBoxItem Content="Sketchy only" Tag="010"/>
                            <ComboBoxItem Content="NSFW only" Tag="001"/>
                            <ComboBoxItem Content="Sketchy + NSFW" Tag="011"/>
                            <ComboBoxItem Content="Everything" Tag="111"/>
                        </ComboBox>
                        <Button x:Name="MarketApiKeyButton" Content="&#xE8D7;" FontFamily="{StaticResource IconFont}" Style="{StaticResource PillButton}" Click="MarketApiKey_Click" Padding="10,8"
                                ToolTip="Wallhaven API key. Wallhaven needs it for NSFW results." AutomationProperties.Name="Wallhaven API key"/>
                    </StackPanel>
                    <WrapPanel x:Name="MarketSortBar" VerticalAlignment="Center" AutomationProperties.Name="Sort wallpapers">
                        <Button x:Name="MarketTopSortButton" Content="Top this month" Tag="toplist" Click="MarketSort_Click" Style="{StaticResource PillButton}" Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,6,0"/>
                        <Button x:Name="MarketNewestSortButton" Content="Newest" Tag="date_added" Click="MarketSort_Click" Style="{StaticResource PillButton}" Margin="0,0,6,0"/>
                        <Button x:Name="MarketFavoritesSortButton" Content="Most loved" Tag="favorites" Click="MarketSort_Click" Style="{StaticResource PillButton}" Margin="0,0,6,0"/>
                        <Button x:Name="MarketRelevantSortButton" Content="Relevant" Tag="relevance" Click="MarketSort_Click" Style="{StaticResource PillButton}"/>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
        <Grid x:Name="LocalGalleryPane" Grid.Row="2" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="LocalGalleryFrame" Margin="0,0,12,0">
                <ListBox x:Name="Gallery" SelectionChanged="Gallery_SelectionChanged" MouseDoubleClick="Gallery_DoubleClick"
                         Background="{DynamicResource PaneBaseBrush}" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Asset.Name}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Margin" Value="0,0,12,14"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Style="{StaticResource InteractiveCard}" CornerRadius="14" BorderThickness="1"
                                                Background="Transparent" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource GalleryCardWidth}}" ToolTip="{Binding Asset.FilePath}">
                                <Grid Height="140">
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="13,13,0,0"/>
                                    <TextBlock Text="{Binding Placeholder}" Style="{StaticResource HintText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border CornerRadius="13,13,0,0"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border>
                                    <CheckBox IsChecked="{Binding IsPicked, Mode=TwoWay}" IsEnabled="{Binding Exists}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="9" ToolTip="Select for profile" AutomationProperties.Name="Select wallpaper for profile"/>
                                </Grid>
                                <StackPanel Margin="13,12">
                                    <TextBlock Text="{Binding Asset.Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Style="{StaticResource HintText}" FontSize="14"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="35" IsHitTestVisible="False"/>
            </Grid>
            <Border x:Name="DetailsFrame" Visibility="Collapsed" Grid.Column="1" Background="Transparent" CornerRadius="0" Padding="16,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="BackToCollectionButton" Content="Back to collection" Click="BackToCollection_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,16"/>
                        <TextBlock Text="Wallpaper details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock x:Name="SelectionHint" Text="Choose a wallpaper"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AssetNameBox" FontSize="16"/>
                            <CheckBox x:Name="FavoriteBox" Content="Keep in favorites" Style="{StaticResource SwitchStyle}" Margin="0,16,0,16"/>
                            <TextBlock Text="Tags" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TagsBox" ToolTip="Separate tags with commas"/>
                            <TextBlock Text="Collection" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                            <TextBox x:Name="AssetCollectionBox"/>
                            <Button x:Name="SaveDetailsButton" Content="Save details" Style="{StaticResource PrimaryButton}" Click="SaveDetails_Click" Margin="0,18,0,0"/>
                            <TextBlock x:Name="SourceText" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,18,0,0"/>
                            <TextBlock x:Name="MissingText" Text="Source file missing"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Button Content="Remove" Style="{StaticResource DangerButton}" Click="Remove_Click" Margin="0,18,0,0"
                                    ToolTip="Removes the library entry. The original file and existing profiles are kept."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid x:Name="LocalFooter" Grid.Row="3" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,12,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PreviousButton" Content="←" ToolTip="Previous page" AutomationProperties.Name="Previous page" Click="Previous_Click" Padding="10,4"/>
                    <TextBlock x:Name="PageText" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0"/>
                    <Button x:Name="NextButton" Content="→" ToolTip="Next page" AutomationProperties.Name="Next page" Click="Next_Click" Padding="10,4"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" MaxWidth="300">
                <TextBlock x:Name="LibrarySelectionText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ClearPickedButton" Content="Clear" Visibility="Collapsed" Click="ClearPicked_Click" Margin="0,0,8,0"/>
                    <Button x:Name="UseButton" Content="Use in profile" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="Use_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid x:Name="MarketPane" Grid.Row="2" Grid.RowSpan="2" Margin="20,0,20,18" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="MarketGalleryColumn" Width="*"/><ColumnDefinition x:Name="MarketDetailsColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="2" Margin="0,12,0,0">
                <ListBox x:Name="MarketGallery" Background="Transparent" BorderThickness="0" Padding="0" Margin="-5,0,-5,0"
                         Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel" SizeChanged="MarketGallery_SizeChanged"
                         SelectionChanged="MarketGallery_SelectionChanged" ScrollViewer.ScrollChanged="MarketGallery_ScrollChanged">
                    <ListBox.Resources>
                        <sys:Double x:Key="TileWidth">300</sys:Double>
                        <sys:Double x:Key="TileHeight">169</sys:Double>
                    </ListBox.Resources>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Wallpaper.Name}"/>
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Ring" Margin="4" Padding="1" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent"><ContentPresenter/></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}" CornerRadius="9" Background="{DynamicResource SurfaceRaisedBrush}"
                                    local:RoundedClip.Radius="9" ToolTip="{Binding Wallpaper.Name}">
                                <Grid>
                                    <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Rectangle><Rectangle.Fill><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
                                    <Border x:Name="Info" VerticalAlignment="Bottom" Padding="10,22,10,8" Opacity="0" IsHitTestVisible="False">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#B3000000" Offset="1"/>
                                        </LinearGradientBrush></Border.Background>
                                        <TextBlock Text="{Binding Wallpaper.Caption}" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Info" Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="MarketEmptyText" Text="Search tags to discover wallpapers" Style="{StaticResource HintText}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="25" IsHitTestVisible="False"/>
            </Grid>
            <Border x:Name="MarketDetails" Grid.ColumnSpan="2" Panel.ZIndex="5" Visibility="Collapsed" Background="{DynamicResource BgBrush}" Padding="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="MarketBackToGalleryButton" DockPanel.Dock="Right" Click="MarketBackToGallery_Click" Style="{StaticResource PillButton}" VerticalAlignment="Top" Margin="10,0,0,0"
                                ToolTip="Back to all wallpapers (Esc)" AutomationProperties.Name="Back to all wallpapers">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="All wallpapers" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <TextBlock x:Name="MarketPositionText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <StackPanel>
                            <TextBlock x:Name="MarketNameText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="MarketInfoText" Style="{StaticResource HintText}"/>
                                <TextBlock x:Name="MarketUploaderText" Style="{StaticResource HintText}" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                    <Button x:Name="MarketExpandPreviewButton" Click="MarketExpandPreview_Click" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="Open full-screen preview" AutomationProperties.Name="Open large wallpaper preview" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand">
                            <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                            <Grid Background="#000000" local:RoundedClip.Radius="12">
                                <Image x:Name="MarketPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="MarketPreviewStatus" Style="{StaticResource HintText}" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False"/>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                    <TextBlock Text="Expand ↗" FontSize="12"/>
                                </Border>
                            </Grid>
                    </Button>
                        <Button x:Name="MarketPreviousButton" Click="MarketPrevious_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                Style="{StaticResource PillButton}" Padding="12,12" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                ToolTip="Previous wallpaper (←)" AutomationProperties.Name="Previous wallpaper"/>
                        <Button x:Name="MarketNextButton" Click="MarketNext_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Style="{StaticResource PillButton}" Padding="12,12" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                ToolTip="Next wallpaper (→)" AutomationProperties.Name="Next wallpaper"/>
                        <Button x:Name="MarketTagsButton"
                                Click="MarketTags_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="12,6"
                                Background="{DynamicResource SurfaceRaisedBrush}" ToolTip="Browse and search wallpaper tags" AutomationProperties.Name="Browse wallpaper tags">
                            <TextBlock Text="{Binding Items.Count, ElementName=MarketTags, StringFormat=Tags ({0})}"/>
                        </Button>
                        <Popup x:Name="MarketTagsPopup" PlacementTarget="{Binding ElementName=MarketTagsButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" Opened="MarketTagsPopup_Opened">
                            <Border Width="336" Padding="8" CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <ScrollViewer x:Name="MarketTagsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="180">
                                    <StackPanel PreviewKeyDown="MarketTagsPopup_KeyDown" KeyboardNavigation.TabNavigation="Cycle">
                                        <TextBlock x:Name="MarketTagStatus" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="MarketTags">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Tag="{Binding Id}" Click="MarketTag_Click" Margin="0,0,4,4" Padding="8,4" FontSize="12" MaxWidth="304"
                                                        ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Search this exact website tag">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="MarketDownloadButton" Content="Download to library" Style="{StaticResource AccentPillButton}" Click="MarketDownload_Click" IsEnabled="False" Margin="0,0,8,4" Padding="18,9"/>
                        <Button x:Name="MarketUseButton" Content="Use in profile" Click="MarketUse_Click" Style="{StaticResource PillButton}" Visibility="Collapsed" Margin="0,0,8,4"/>
                        <Button x:Name="MarketSourceButton" Content="View on Wallhaven ↗" Click="MarketSource_Click" Style="{StaticResource PillButton}" Margin="0,0,0,4" ToolTip="Images belong to their original owners. Downloads are saved to your Belie library."/>
                    </WrapPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <ProgressBar x:Name="MarketProgress" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button x:Name="MarketLoadMoreButton" DockPanel.Dock="Right" Content="Load more" Click="MarketLoadMore_Click" Visibility="Collapsed" Margin="10,0,0,0"/>
                    <Button x:Name="MarketCancelButton" DockPanel.Dock="Right" Content="Cancel download" Click="MarketCancel_Click" Visibility="Collapsed" Margin="10,0,0,0"/>
                    <TextBlock x:Name="MarketStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
