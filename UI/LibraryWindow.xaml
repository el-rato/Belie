<Window x:Class="WallpaperProfiles.UI.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="Wallpaper library" Width="1000" Height="720"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="{StaticResource BgBrush}"
        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
    <Grid x:Name="LibraryRoot" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <Button x:Name="BackButton" Content="Back to profiles" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="18,0" Padding="10,5" Click="Close_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="LibraryTitle" Text="Wallpaper library" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="18,0"/>
                <Button x:Name="LibraryCloseButton" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Margin="0,0,6,0" Click="Close_Click" ToolTip="Close library"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="20,18,20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ImportFilesButton" Content="Import files" Click="ImportFiles_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ImportFolderButton" Content="Import folder" Click="ImportFolder_Click"/>
                </StackPanel>
                <TextBlock Text="Your desktop, collected." FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Bring in images and videos, then organize them into your own collections."
                       Style="{StaticResource HintText}" Margin="0,7,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Search names, tags, or collections" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Margin="0,0,12,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Collection" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CollectionFilter" DisplayMemberPath="Label" SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <CheckBox Grid.Column="2" x:Name="FavoritesFilter" Content="Favorites only" Margin="16,20,0,0"
                          VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <ListBox x:Name="Gallery" SelectionChanged="Gallery_SelectionChanged"
                         Background="{StaticResource BgBrush}" BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="7" BorderThickness="2"
                                                Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="194" ToolTip="{Binding Asset.FilePath}">
                                <Grid Height="116" Background="{StaticResource SurfaceBrush}">
                                    <TextBlock Text="{Binding Placeholder}" Style="{StaticResource HintText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Grid>
                                <StackPanel Margin="10,9">
                                    <TextBlock Text="{Binding Asset.Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Style="{StaticResource HintText}" FontSize="14"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="35" IsHitTestVisible="False"/>
            </Grid>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Wallpaper details" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                        <TextBlock x:Name="SelectionHint" Text="Select a wallpaper to organize it or use it in a profile."
                                   Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AssetNameBox"/>
                            <CheckBox x:Name="FavoriteBox" Content="Favorite" Margin="0,16,0,16"/>
                            <TextBlock Text="Tags (comma separated)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TagsBox"/>
                            <TextBlock Text="Collection (new or existing)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                            <TextBox x:Name="AssetCollectionBox"/>
                            <Button x:Name="SaveDetailsButton" Content="Save details" Click="SaveDetails_Click" Margin="0,18,0,0"/>
                            <TextBlock x:Name="SourceText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                            <TextBlock x:Name="MissingText" Text="Source file is missing. Restore it to its original location to use this wallpaper."
                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Button Content="Remove from library" Click="Remove_Click" Margin="0,18,0,0"
                                    ToolTip="Removes the library entry. The original file and existing profiles are kept."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,12,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PreviousButton" Content="Previous" Click="Previous_Click" Padding="10,4"/>
                    <TextBlock x:Name="PageText" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0"/>
                    <Button x:Name="NextButton" Content="Next" Click="Next_Click" Padding="10,4"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" x:Name="UseButton" Content="Use in profile" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" VerticalAlignment="Bottom" Click="Use_Click"/>
        </Grid>
    </Grid>
</Window>
