<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <StartupObject>WallpaperProfiles.App</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WallpaperProfiles</RootNamespace>
    <AssemblyName>Belie</AssemblyName>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Keep this release version aligned with CHANGELOG.md; changes on main publish an update. -->
    <Version>4.2.3</Version>
    <FileVersion>4.2.3.0</FileVersion>
    <AssemblyVersion>4.2.3.0</AssemblyVersion>
    <Product>Belie</Product>
    <Description>Wallpaper profiles with a top bar, tiling workspaces, desktop widgets, live wallpapers, scenes, schedules, and event triggers.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- Belie sits in the background with a small heap, so less memory matters more than throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WallpaperProfiles.Tests" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="Belie.ReleaseNotes.md" />
  </ItemGroup>

  <!-- The test project lives inside this folder tree; keep its sources out of the app assembly. -->
  <ItemGroup>
    <Compile Remove="WallpaperProfiles.Tests\**" />
  </ItemGroup>

</Project>
